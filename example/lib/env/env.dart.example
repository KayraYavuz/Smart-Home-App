// Template for lib/env/env.dart — copy this file to env.dart and fill in
// your own credentials. env.dart is gitignored and MUST NOT be committed.
//
// NOTE: The XOR scheme below is light obfuscation only (it keeps secrets out
// of plaintext string scans of the binary). It is NOT real encryption — anyone
// with the app can recover the values. Never rely on it to protect a secret
// that would cause harm if leaked. Prefer build-time injection
// (`--dart-define`) or a secrets manager for production.
class Env {
  // Fill these with your real values, then run the project once. The simplest
  // path during development is to return the plaintext directly:
  //
  //   static String get ttlockClientId => 'your_client_id';
  //
  // Or keep the XOR helper below and encode your strings with the same key.
  static String get ttlockClientId => _decode(<int>[]);
  static String get ttlockClientSecret => _decode(<int>[]);
  static String get ttlockUsername => _decode(<int>[]);
  static String get ttlockPassword => _decode(<int>[]);

  // bytes[i] = char[i] ^ 0x42  (encode and decode use the same operation)
  static String _decode(List<int> bytes) {
    return String.fromCharCodes(bytes.map((e) => e ^ 0x42));
  }
}
